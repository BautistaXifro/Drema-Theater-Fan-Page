@model Dream_Theater_Fan_Page.Models.Integrante

@{
    ViewData["Title"] = "Editar Integrante";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Editar Integrante</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="IntegranteId" />
    <input type="hidden" asp-for="BandaId" />

    <div class="form-group">
        <label>Nombre del Integrante</label>
        <input asp-for="Nombre" class="form-control" required />
    </div>

    <div class="form-group mt-2">
        <label>Instrumento</label>
        <input asp-for="Instrumento" class="form-control" required />
    </div>

    <div class="form-group mt-2">
        <label>Biografía</label>
        <textarea asp-for="Biografia" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-success mt-3">Guardar Cambios</button>
    <a asp-controller="Banda" asp-action="Index" class="btn btn-secondary mt-3">Cancelar</a>
</form>
