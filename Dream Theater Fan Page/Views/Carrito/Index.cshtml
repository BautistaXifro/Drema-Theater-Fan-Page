@model IEnumerable<Dream_Theater_Fan_Page.Models.Producto>

@{
    ViewData["Title"] = "Carrito de Compra";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<form method="get" asp-controller="Carrito" asp-action="Index" class="row g-3 mb-3">
    <div class="col-md-4">
        <label>Nombre del producto</label>
        <input type="text" name="searchName" class="form-control" placeholder="Buscar nombre..." />
    </div>
    <div class="col-md-2">
        <label>Precio mínimo</label>
        <input type="number" name="minPrice" class="form-control" step="0.01" />
    </div>
    <div class="col-md-2">
        <label>Precio máximo</label>
        <input type="number" name="maxPrice" class="form-control" step="0.01" />
    </div>
    <div class="col-md-2 align-self-end">
        <button type="submit" class="btn btn-primary">Filtrar</button>
    </div>
</form>

<table class="table table-dark table-striped mt-4">
    <tr>

        <th>ProductoId</th>
        <th>Nombre</th>
        <th>Descripcion</th>
        <th>Photo</th>
        <th>Precio</th>
        <th>Action</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ProductoId</td>
            <td>@item.Nombre</td>
            <td>@item.Descripcion</td>
            <td><img src="@item.Photo" width="120" /></td>
            <td>@item.Precio</td>
            <td>
                <a class="btn btn-primary" asp-controller="Carrito" asp-action="Cart" asp-route-id="@item.ProductoId">Comprar</a>
            </td>
        </tr>
    }
</table>
