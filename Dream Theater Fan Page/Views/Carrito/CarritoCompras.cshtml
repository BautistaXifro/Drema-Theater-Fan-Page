@model IEnumerable<Dream_Theater_Fan_Page.Models.CarritoCompras.Item>

@{
    ViewData["Title"] = "Carrito de Compra Items";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<table class="table table-dark table-responsive table-hover">
    <tr>
        <th>Estado</th>
        <th>ProductoId</th>
        <th>Nombre</th>
        <th>Descripcion</th>
        <th>Photo</th>
        <th>Precio</th>
        <th>Cantidad</th>
        <th>Sub Total</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>
                <a class="btn btn-primary" href="/Carrito/Quitar?id=@item.Producto.ProductoId">Quitar</a>
                @*<a class="btn btn-primary" asp-action="Quitar" asp-controller="Carrito" asp-route-id=@item.Producto.ProductoId>Quitar</a>*@
            </td>
            <td>@item.Producto.ProductoId</td>
            <td>@item.Producto.Nombre</td>
            <td>@item.Producto.Descripcion</td>
            <td><img src="@item.Producto.Photo" width="120" /></td>
            <td>@item.Producto.Precio</td>
            <td>@item.Cantidad</td>
            <td>@(item.Producto.Precio * item.Cantidad)</td>
        </tr>
    }    
</table>
<div class="align-items-end">
    <label class="form-label">Total</label>
    <label class="form-label"> @Model.Sum(i => i.Cantidad * i.Producto.Precio)</label>
</div>
<br />
@* <a class="btn btn-info" asp-action="Index" asp-controller="Carrito">Volver</a>*@
<a class="btn btn-info" href="/Carrito">Volver</a>