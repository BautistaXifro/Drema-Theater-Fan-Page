@model Dream_Theater_Fan_Page.Models.Banda

@{
    ViewData["Title"] = "Crear Banda";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Crear Banda</h2>

<form asp-action="Create" method="post" onsubmit="return prepararIntegrantesParaEnvio();">
    <div class="form-group">
        <label>Nombre de la Banda</label>
        <input asp-for="Nombre" class="form-control" required />
    </div>

    <hr />
    <h4>Integrantes</h4>

    <button type="button" class="btn btn-secondary mb-3" data-bs-toggle="modal" data-bs-target="#modalIntegrante">
        Agregar Integrante
    </button>

    <ul class="list-group mb-3" id="listaIntegrantes">
    </ul>

    <div id="camposIntegrantes"></div>

    @Html.Partial("_IntegrantesModal")

    <button type="submit" class="btn btn-success">Guardar Banda</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
