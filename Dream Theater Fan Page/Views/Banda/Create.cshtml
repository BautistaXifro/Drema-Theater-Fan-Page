@model Dream_Theater_Fan_Page.Models.Banda

@{
    ViewData["Title"] = "Crear Banda";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Crear Banda</h2>


<form asp-action="Create" method="post" enctype="multipart/form-data" onsubmit="return prepararIntegrantesParaEnvio();">
    <div class="form-group">
        <label asp-for="Nombre">Nombre de la Banda</label>
        <input asp-for="Nombre" class="form-control" required />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="form-group mt-2">
        <label>Foto de la Banda</label>
        <input type="file" name="PhotoFile" class="form-control" accept="image/*" />
    </div>
    <hr />
    <h4>Integrantes</h4>

    <button type="button" class="btn btn-secondary mb-3" data-bs-toggle="modal" data-bs-target="#modalIntegrante">
        Agregar Integrante
    </button>

    <ul class="list-group mb-3" id="listaIntegrantes">
    </ul>

    <div id="camposIntegrantes"></div>

    @Html.Partial("_IntegrantesModal")

    <button type="submit" class="btn btn-success">Guardar Banda</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}