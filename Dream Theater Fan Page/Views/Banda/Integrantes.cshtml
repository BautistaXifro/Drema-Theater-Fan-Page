@model IEnumerable<Dream_Theater_Fan_Page.Models.Integrante>

@{
    ViewData["Title"] = "Integrantes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Integrantes de @ViewBag.BandaNombre</h2>

@if (Model != null && Model.Any())
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Instrumento</th>
                <th>Biografía</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var integrante in Model)
            {
                <tr>
                    <td>@integrante.Nombre</td>
                    <td>@integrante.Instrumento</td>
                    <td>@integrante.Biografia</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No hay integrantes para esta banda.</p>
}
<a class="btn btn-secondary" asp-action="Index">Volver</a>
